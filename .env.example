# VITE_API_BASE_URL: The base URL of your Spring Boot backend service.
# For local development: http://localhost:8080
# For production: Update to your deployed Spring Boot URL (e.g. https://your-spring-boot-api.com)
VITE_API_BASE_URL=http://localhost:8080

# GEMINI_API_KEY: Required for Gemini AI API calls (if server features enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

